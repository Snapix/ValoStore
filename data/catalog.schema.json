{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValoStore catalogue",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "sources",
    "counts",
    "apps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "generatedAt": {
      "type": "string"
    },
    "sources": {
      "type": "object"
    },
    "counts": {
      "type": "object"
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "platform",
          "appId",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "enum": [
              "F-Droid",
              "Flathub",
              "WinGet"
            ]
          },
          "platform": {
            "enum": [
              "android",
              "linux",
              "windows"
            ]
          },
          "appId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}